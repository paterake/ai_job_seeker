# PII & generated outputs — never enter git
#   - candidate profiles (PII: contact, CV data)
#   - job ingest pools + ranked shortlists (per-run generated artefacts;
#     also timestamped * YYYYMMDD_HHMM files accumulate forever)
implementation/job_seeker/config/profile/
implementation/job_seeker/config/output/

# Local scratch / credential install staging — may hold secrets before copy-out.
# Never commit anything under .ignore/.
.ignore/
