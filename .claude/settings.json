{
  "_comment": "Repo-owned harness settings. The baseline hooks run the gate adapters that distill_harness.py wire installs in hooks/. Add project-specific hooks below the governed baseline.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_execution_limits.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_guard.sh"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_data_guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/agent-harness/cloud_only.sh",
            "args": [
              "gate_commit.sh"
            ],
            "if": "Bash(git *)",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/agent-harness/cloud_only.sh",
            "args": [
              "check_work_ids.sh"
            ],
            "if": "Bash(git *)",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^mcp__claude-code-remote__create_session$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/agent-harness/cloud_only.sh",
            "args": [
              "gate_dispatch.sh"
            ],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^mcp__claude-code-remote__add_repo$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/agent-harness/cloud_only.sh",
            "args": [
              "gate_add_repo.sh"
            ],
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/agent-harness/cloud_only.sh",
            "args": [
              "session_start.sh",
              "1"
            ]
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/agent-harness/cloud_only.sh",
            "args": [
              "session_start.sh",
              "2"
            ]
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/agent-harness/cloud_only.sh",
            "args": [
              "session_start.sh",
              "3"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^SubagentHandback$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/agent-harness/cloud_only.sh",
            "args": [
              "record_pass.sh"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/agent-harness/cloud_only.sh",
            "args": [
              "session_length_hook.sh"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(agent-harness:)?reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/agent-harness/cloud_only.sh",
            "args": [
              "record_pass.sh"
            ]
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git push origin --delete slice/*)",
      "Bash(git push origin --delete fleet/*)",
      "Bash(git branch -d *)",
      "Bash(git branch -D slice/*)",
      "Bash(git branch -D fleet/*)",
      "Bash(git worktree remove *)",
      "mcp__claude-code-remote__add_repo"
    ],
    "deny": [
      "Bash(git worktree remove --force *)",
      "Bash(git worktree remove -f *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
