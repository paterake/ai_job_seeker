#!/usr/bin/env bash
# pre-commit — git hook: require a capability-decision record when a commit adds or changes a
# parser-/extractor-shaped content-interpretation surface. It checks what is staged, which is exactly what the
# commit records, so it reaches every tool that commits (any agent, Copilot, a terminal) and every command form.
# Installed by core.hooksPath=ai_context/pco/ai_harness/hooks (set by distill_harness.py sync / wire / init-consumer
# and by setup_cloud_session.sh). Block: exit 1 with a GOVERNANCE DENY on stderr. Needs only git.
set -euo pipefail

# core.quotePath=false: list non-ASCII paths as-is, not C-quoted, so they match the patterns and can be read.
GIT=(git -c core.quotePath=false)

STAGED=()
while IFS= read -r line; do
    [[ -n "$line" ]] && STAGED+=("$line")
done < <("${GIT[@]}" diff --cached --name-only --diff-filter=ACMR)
[[ "${#STAGED[@]}" -eq 0 ]] && exit 0

SOURCE_RE='\.(py|ts|tsx|js|jsx)$'
SHAPE_RE='(parser|extract|extraction|distill|classifier|classification|semantic|grounding|normalis|normaliz|inference|entity|relation|facet)'
CODE_DIR_RE='(^|/)(src|implementation|app|lib|packages|modules)/'

require_record=0
for path in "${STAGED[@]}"; do
    if [[ "$path" =~ $SOURCE_RE ]] && [[ "$path" =~ $SHAPE_RE ]]; then
        require_record=1
    fi
done

if [[ "$require_record" -eq 0 ]]; then
    new_source_count="$(
        "${GIT[@]}" diff --cached --name-only --diff-filter=A \
        | awk -v code_re="$CODE_DIR_RE" '$0 ~ /\.(py|ts|tsx|js|jsx)$/ && $0 ~ code_re { c++ } END { print c + 0 }'
    )"
    # Word boundaries are spelled out because mawk has no \b.
    keyword_hits="$(
        "${GIT[@]}" diff --cached --unified=0 -- . ':(exclude)audit/capability_decisions/*' \
        | awk '
            /^\+/ && $0 !~ /^\+\+\+/ && $0 ~ /(^|[^[:alnum:]_])(parse|parser|extract|distill|classif|semantic|infer|ground|facet|entity|relation)([^[:alnum:]_]|$)/ { c++ }
            END { print c + 0 }
        '
    )"
    if [[ "$new_source_count" -ge 4 ]] && [[ "$keyword_hits" -ge 1 ]]; then
        require_record=1
    fi
fi
[[ "$require_record" -eq 0 ]] && exit 0

deny() {
    printf 'GOVERNANCE DENY\nrisk_tier: high\ndenial_reason: %s\npolicy_set: pco-core/v1\n%s' "$1" "$2" >&2
    exit 1
}

RECORDS=()
while IFS= read -r line; do
    [[ -n "$line" ]] && RECORDS+=("$line")
done < <(
    printf '%s\n' "${STAGED[@]}" \
    | grep -E '^audit/capability_decisions/.*\.md$' \
    | grep -Ev '^audit/capability_decisions/README\.md$' || true
)

if [[ "${#RECORDS[@]}" -eq 0 ]]; then
    deny capability_decision_required "next_action: stage a capability-decision record under audit/capability_decisions/ using audit/templates/capability_decision_record.md, then commit again
"
fi

missing_fields=()
for record in "${RECORDS[@]}"; do
    staged_record="$("${GIT[@]}" show ":$record")"
    for heading in \
        '**Task Type:**' \
        '**Chosen Driver:**' \
        '## Why This Driver Fits' \
        '## Why The Other Driver Was Not Chosen' \
        '## Prompt / Config Consideration'
    do
        if ! printf '%s' "$staged_record" | grep -Fq "$heading"; then
            missing_fields+=("$record :: missing $heading")
        fi
    done
done

if [[ "${#missing_fields[@]}" -gt 0 ]]; then
    deny capability_decision_invalid "detail: $(printf '%s\n' "${missing_fields[@]}" | paste -sd ';' -)
next_action: fill the required sections in the staged capability-decision record, then commit again
"
fi
exit 0
