{
  "_comment": "Project-owned harness settings, symlinked into .claude/.trae. Hook paths are harness-agnostic (resolved from the git root) so the same file works under every harness. Add project-specific hooks below the governed baseline.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/ai_context/pco/ai_harness/hooks/check_exception_expiry.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/ai_context/pco/ai_harness/hooks/check_capability_decision.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/ai_context/pco/ai_harness/hooks/check_execution_limits.sh\""
          }
        ]
      }
    ]
  }
}
